/* USER CODE BEGIN 4 */ 
void Seven_Segment_Digit (unsigned char digit, unsigned char hex_char) 
{ 
* 
/******************************************************************************
Code to mask and bit shift 0-7 value of digit and 0-15 value of hex_char 
to output correct bit pattern to GPIO_Output 
******************************************************************************
*/ 
FF00 
} 
//output 7 segment pattern. keep lowest 8 bits as 7 segment, raise first 7 bits with 
GPIOE->ODR = ~(((1 << (digit + 8)) & 0xFF00) | _7SEG[hex_char]); 
// Set all selects high to latch-in character 
GPIOE->ODR |= 0xFF00; 
return; 
void Seven_Segment(unsigned int HexValue) 
{ 
/****************************************************************************** 
Use a for loop to output HexValue to 7 segment display digits 
*******************************************************************************/ 
char digit; 
// Send hex values to lower 4 digits 
for (digit=0 ; digit<8 ; digit++) 
{ 
// call Seven segment digit function, using provided int value for hex values 
// bit shift by 4 * digit, and with 0 
Seven_Segment_Digit(digit, (HexValue >> (4 * digit)) & 0xF); /*Replace 0 with 
correct HexValue characters*/ 
} 
return; 
} 
