  GPIOE->MODER |= 0x55555555; // Port E mode register
  GPIOC->MODER |= 0x0; // Port C mode register - all inputs
  GPIOE->ODR = 0xFFFF; // Set all Port E pins high

  /*** Configure ADC1 ***/
  RCC->APB2ENR |= 1<<8;  // Turn on ADC1 clock by forcing bit 8 to 1 while keeping other bits unchanged
  ADC1->SMPR2 |= 1; // 15 clock cycles per sample
  ADC1->CR2 |= 1;        // Turn on ADC1 by forcing bit 0 to 1 while keeping other bits unchanged

  /*****************************************************************************************************
  These commands are handled as part of the MX_TIM7_Init() function and don't need to be enabled
  RCC->AHB1ENR |= 1<<5; // Enable clock for timer 7
  __enable_irq(); // Enable interrupts
  NVIC_EnableIRQ(TIM7_IRQn); // Enable Timer 7 Interrupt in the NVIC controller
  *******************************************************************************************************/

  TIM7->PSC = 199; //40Khz timer clock prescaler value, 40Khz = 16Mhz / 200
  TIM7->ARR = 1; // Count to 1 then generate interrupt (divide by 2), 20Khz interrupt rate to increment byte counter for 78Hz PWM
  TIM7->DIER |= 1; // Enable timer 7 interrupt
  TIM7->CR1 |= 1; // Enable timer counting

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  /* CALL THE ASSEMBLY LANGUAGE POWER FUNCTION HERE
   * *************************************************/

  int answer = 0;
  int r1 = 1;
  int r2 = 1;

  /****************************************************/
  while (1)
  {

      r1 = GPIOC->IDR & 0xF; //Use switches 1-4 to set r1

      r2 = (GPIOC->IDR >> 4) & 0xF; //Use switches 5-8 to set r2

      /** Display input for r1 on digits 6 and 7 */
      Seven_Segment_Digit(6, r1 % 10, 0);
      Seven_Segment_Digit(7, (r1 / 10) % 10, 0);

      // Display input for r2 on digits 4 and 5
      Seven_Segment_Digit(4, r2 % 10, 0);
      Seven_Segment_Digit(5, (r2 / 10) % 10, 0);

      // Call the resistor divider function in math.s
      if ((r1 + r2) != 0)
      {
          answer = res_div(r1, r2);
      }
      else
      {
          answer = 0;
      }

      // Display the answer on digits 0 to 3
      Seven_Segment_Digit(0, answer % 10, 0);
      Seven_Segment_Digit(1, (answer / 10) % 10, 0);
      Seven_Segment_Digit(2, (answer / 100) % 10, 0);
      Seven_Segment_Digit(3, (answer / 1000) % 10, 1);

      /* USER CODE BEGIN 3 */
  }
    /* USER CODE BEGIN 3 */
  }

