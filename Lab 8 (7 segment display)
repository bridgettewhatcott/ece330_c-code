//   
//   
for (i=0 ; i<8 ; i++) 
{ 
} 
Seven_Segment_Digit(i,i); 
HAL_Delay(5000); // delay for 5000 milliseconds 
// 
//   
// 
//   
Seven_Segment(0x5ADFACE5); 
HAL_Delay(5000); // delay for 5000 milliseconds 
/*read from port C register, bit shift of 12*/ 
cw = GPIOC->IDR>>12; 
 
/*bit shift again in the other direction, now being read from port D register*/ 
GPIOD->ODR = cw << 12; 
/*check port C output for PC10, checking for LOW because only bit 10 is set to 1*/ 
if (!(GPIOC->IDR & (1 << 10))) 
{ 
/*increase by one, use modulo to keep the value between 0 and 7*/ 
/*this runs if PC10 is LOW*/ 
sc = (sc+1) % 8; 
} 
/*check port C output for PC11*/ 
if (!(GPIOC->IDR & (1 << 11))) 
{ 
/*this runs if PC11 is LOW*/ 
/*call the function, pass in current values*/ 
Seven_Segment_Digit(sc,cw); 
} 
/*select one bit, set it to HIGH without clearing other bits, turning on output pin*/ 
GPIOD->ODR |= 1 << sc; 
/*add a reasonable delay so that action from code is visible on board*/ 
HAL_Delay(200); 
/* USER CODE BEGIN 3 */ 
} 
